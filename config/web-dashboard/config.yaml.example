# Web Dashboard 插件配置示例
# 复制此文件为 config.yaml 并根据需要修改

# 显示的服务器 IP/域名（用于前端显示）
displayIp: "your-server.com:666"

# Session 密钥（强烈建议修改为随机字符串）
sessionSecret: "change-this-to-a-random-secret"

# 登录失败后 IP 黑名单持续时间（秒）
loginBlacklistDuration: 600

# 验证码提供商 (geetest / none)
captchaProvider: none

# 极验验证码配置（仅当 captchaProvider=geetest 时需要）
# geetestId: "your-geetest-id"
# geetestKey: "your-geetest-key"

# 允许的跨域来源 (多个用数组格式)
allowedOrigins:
  - http://localhost:28080
  - https://your-domain.com

# Web 房间过滤规则
# 启用公开模式（仅显示特定前缀的房间）
enablePubWeb: false
# 公开房间前缀
pubPrefix: "pub"

# 启用私密模式（隐藏特定前缀的房间）
enablePriWeb: false
# 私密房间前缀
priPrefix: "sm"
