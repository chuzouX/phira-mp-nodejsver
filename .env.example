# 游戏服务器配置
PORT=12346
HOST=0.0.0.0
TCP_ENABLED=true
USE_PROXY_PROTOCOL=false
# 代理信任层级（防止 IP 封禁绕过）
# 仅 Nginx 设为 1；CDN + Nginx 设为 2
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
NODE_ENV=development
PHIRA_API_URL=https://phira.5wyxi.com
SERVER_NAME=Server
ROOM_SIZE=8
SERVER_ANNOUNCEMENT="你好{{name}}，欢迎来到 {{serverName}} 服务器"

# Web 宿主配置
WEB_PORT=8080
# 是否启用 HTTP 宿主（供 API / 插件挂载）
ENABLE_WEB_SERVER=false
DEFAULT_AVATAR=https://phira.5wyxi.com/files/6ad662de-b505-4725-a7ef-72d65f32b404

# Web 房间可见性配置
# 是否启用公开房间前缀过滤
ENABLE_PUB_WEB=false
# 公开房间前缀
PUB_PREFIX=pub
# 是否启用私密房间前缀过滤
ENABLE_PRI_WEB=false
# 私密房间前缀
PRI_PREFIX=sm

# 启用启动时自动检查更新
ENABLE_UPDATE_CHECK=true

# 服务器核心配置
# 管理员 Phira ID（多个用逗号分隔）
ADMIN_PHIRA_ID=
# 拥有者 Phira ID（多个用逗号分隔）
OWNER_PHIRA_ID=
# 封禁白名单 - 用户 ID（多个用逗号分隔）
BAN_ID_WHITELIST=
# 封禁白名单 - IP 地址（多个用逗号分隔）
BAN_IP_WHITELIST=
# 静默用户 ID（不记录其触摸/判定日志，多个用逗号分隔）
SILENT_PHIRA_IDS=

# 插件系统配置
# 是否启用插件系统
PLUGINS_ENABLED=true
# 插件会默认自动从 plugins/ 目录加载全部插件