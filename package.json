{
  "name": "phira-mp-server",
  "version": "0.6.2",
  "description": "TypeScript Node.js server with TCP socket support",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:plugins",
    "build:plugins": "tsc -p plugins/tsconfig.json && npm run build:server-control-ui",
    "build:server-control-ui": "vite build --config plugins/server-control/ui/vite.config.ts",
    "server-control:hash": "node plugins/server-control/scripts/hash-password.js",
    "plugin:create": "node scripts/create-plugin.js",
    "dev": "nodemon",
    "start": "node dist/index.js",
    "test": "jest --verbose --testPathIgnorePatterns=server-control",
    "test:plugins": "jest --verbose test/server-control.test.ts test/server-control-security.test.ts",
    "test:watch": "jest --watch",
    "lint": "eslint src plugins test plugin-api.d.ts --ext .ts",
    "lint:fix": "eslint src plugins test plugin-api.d.ts --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "package:exe": "npm run build && node scripts/package.js win-x64",
    "package:linux": "npm run build && node scripts/package.js linux-x64",
    "package:macos-x64": "npm run build && node scripts/package.js macos-x64",
    "package:macos-arm64": "npm run build && node scripts/package.js macos-arm64",
    "package:all": "npm run package:exe && npm run package:linux && npm run package:macos-x64 && npm run package:macos-arm64"
  },
  "pkg": {
    "assets": [
      "data/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuzouX/phira-mp-nodejsver.git"
  },
  "keywords": [
    "typescript",
    "nodejs",
    "server",
    "tcp"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/chuzouX/phira-mp-nodejsver/issues"
  },
  "homepage": "https://github.com/chuzouX/phira-mp-nodejsver#readme",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@yao-pkg/pkg": "6.10.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.0.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.0",
    "ws": "^8.19.0"
  }
}
